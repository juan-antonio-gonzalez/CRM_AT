# ─────────────────────────────────────────────────────────────────────────────
# CRM-AT — variables de entorno
#
# Copiar a /etc/crm-at/crm-at.env en el VPS y completar los valores reales.
#   cp deploy/env.example /etc/crm-at/crm-at.env
#   chmod 640 /etc/crm-at/crm-at.env && chown root:crmat /etc/crm-at/crm-at.env
#   (install.sh ya deja ese modo y ese dueño; el 600 en root:root es lo que
#    deja el archivo ilegible para el usuario del servicio)
#   # generar una SECRET_KEY nueva:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# ─────────────────────────────────────────────────────────────────────────────

# --- Aplicación -------------------------------------------------------------
APP_NAME="CRM-AT"
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false

# Clave para firmar los JWT de sesión. OBLIGATORIO cambiarla.
# La aplicación arranca con el valor por defecto "change-me-in-production";
# no la dejes así en producción.
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Duración de la sesión, en horas.
SESSION_EXPIRE_HOURS=24

# Poner en true SOLO si se sirve por HTTPS. Con HTTPS activo la cookie de sesión
# se marca Secure y no viaja en claro.
COOKIE_SECURE=true

# Protección CSRF. Debe quedar en true.
CSRF_ENABLED=true

# --- Base de datos ----------------------------------------------------------
# PostgreSQL local del VPS (usuario y base creados por deploy/install.sh).
DATABASE_URL=postgresql://crm_at:CAMBIAR_PASSWORD@127.0.0.1:5432/crm_at

# --- Servidor ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8020
WEB_CONCURRENCY=2

# --- Caty, la instructora de uso --------------------------------------------
#
# Sin clave, Caty no existe: el botón no aparece y la aplicación funciona igual.
# Por eso esta sección es opcional y el resto del archivo no depende de ella.
#
# La clave se saca de https://platform.deepseek.com -> API keys. Es un secreto
# que se cobra: no la compartas ni la subas al repositorio.
DEEPSEEK_API_KEY=

# Modelo. `deepseek-flash` es el barato y alcanza para explicar cómo se usa la
# aplicación; `deepseek-v4-pro` cuesta más y responde mejor si hiciera falta.
DEEPSEEK_MODEL=deepseek-flash

# --- Sembrado inicial -------------------------------------------------------
# Credenciales del primer administrador. Se usan UNA sola vez: si la tabla
# `users` ya tiene filas, el sembrado no hace nada.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=CAMBIAR_ESTA_PASSWORD

# Insertar datos de demostración (clientes y máquinas de ejemplo).
# Dejar en false en producción.
SEED_DEMO_DATA=false

# --- Archivos ---------------------------------------------------------------
UPLOAD_DIR=static/uploads
